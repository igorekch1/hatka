# ── Telegram-бот (обязательно) ───────────────────────────────────────────────
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# id группы, куда слать квартиры (узнать: добавить бота в группу и написать /chatid)
TELEGRAM_CHAT_ID=

# ── ИИ-разбор объявлений (рекомендуется) ─────────────────────────────────────
# Ключ с console.anthropic.com → API Keys. Без него работает фильтр по ключевым словам.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── Telegram-каналы (необязательно) ──────────────────────────────────────────
# api_id и api_hash: my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Строка сессии: `npm run tg-login` на своём компьютере. Это доступ к аккаунту — никому не показывать!
TG_SESSION=
# Каналы через запятую: @username или ссылка t.me/... (вы должны в них состоять)
TG_CHANNELS=

# ── Тонкая настройка ─────────────────────────────────────────────────────────
# Какие источники включены
SOURCES=olx,lun,domria,telegram
# Как часто опрашивать сайты, секунд (DIM.RIA — в 1.5 раза реже)
POLL_SECONDS=60
# Не присылать объявления старше N часов
MAX_AGE_HOURS=3
# Запасной курс, если сайт НБУ недоступен
FX_FALLBACK_UAH_PER_USD=46
DB_PATH=./data/radar.db
