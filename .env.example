# ── City ─────────────────────────────────────────────────────────────────────
# lviv | kyiv | odesa | kharkiv | dnipro  (src/cities.ts)
CITY=lviv
# OLX location ids — known for Lviv only; set them to use OLX in another city
OLX_REGION_ID=
OLX_CITY_ID=

# ── Telegram bot (required) ──────────────────────────────────────────────────
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Group to post listings to (add the bot to the group and send /chatid)
TELEGRAM_CHAT_ID=

# ── LLM parsing (recommended) ────────────────────────────────────────────────
# console.anthropic.com → API Keys. Without it the bot falls back to keyword parsing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── Telegram channels (optional) ─────────────────────────────────────────────
# api_id and api_hash: my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Session string from `npm run tg-login`. Full access to your account — never share it!
TG_SESSION=
# Comma-separated @username or t.me/... links (you must be subscribed)
TG_CHANNELS=

# ── Tuning ───────────────────────────────────────────────────────────────────
# Enabled sources: olx, lun, domria, telegram (OLX currently blocks non-browser clients)
SOURCES=lun,domria,telegram
# Site polling interval, seconds (DIM.RIA is polled 1.5x less often)
POLL_SECONDS=60
# Ignore listings older than N hours
MAX_AGE_HOURS=3
# Fallback UAH/USD rate if the National Bank of Ukraine API is unavailable
FX_FALLBACK_UAH_PER_USD=46
DB_PATH=./data/radar.db
